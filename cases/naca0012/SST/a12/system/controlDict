FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}

application     foamRun;
solver          incompressibleFluid;

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         3000;
deltaT          1;

writeControl    timeStep;
writeInterval   500;
purgeWrite      1;

writeFormat     ascii;
writePrecision  7;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable true;

functions
{
    forceCoeffs
    {
        type            forceCoeffs;
        libs            ("libforces.so");
        writeControl    timeStep;
        writeInterval   500;
        patches         (airfoil);
        rho             rhoInf;
        rhoInf          1;
        magUInf         52.08;
        lRef            1.0;
        Aref            0.1;
        CofR            (0.25 0 0);
        pitchAxis       (0 0 -1);
        liftDir         (-0.20791169 0.97814760 0);
        dragDir         (0.97814760 0.20791169 0);
    }

    yPlus
    {
        type            yPlus;
        libs            ("libfieldFunctionObjects.so");
        writeControl    writeTime;
    }
}
